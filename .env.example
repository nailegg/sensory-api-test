# 로컬 서버
APP_BASE_URL=http://localhost:8000

# Google OAuth 2.0 (GCP 콘솔 > API 및 서비스 > 사용자 인증 정보 > OAuth 클라이언트 ID, 유형: 웹 애플리케이션)
# 승인된 리디렉션 URI: http://localhost:8000/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Google Picker 테스트 페이지(GET /google/picker)용. 콘솔에서 "Google Picker API" 사용 설정 후 API 키 생성.
#   키 제한 권장: 애플리케이션 제한=웹사이트(http://localhost:8000/* 와 https://docs.google.com/*), API 제한=Google Picker API
#   (docs/google_drive.md 2.1절). 브라우저에 노출되는 키라 시크릿은 아니지만 .env에만 둔다.
GOOGLE_PICKER_API_KEY=
# Picker setAppId에 넣는 Cloud 프로젝트 번호(숫자. 프로젝트 ID가 아님). 비우면 GOOGLE_CLIENT_ID 앞의 숫자를 쓴다.
GOOGLE_PROJECT_NUMBER=

# Zoom OAuth (Marketplace > General App, User-managed > App Credentials의 Development 쌍)
# 리다이렉트 URI는 https 필수(2026-10-04 공식 문서 확인): http://localhost는 등록 불가 → ngrok 고정 도메인.
#   Marketplace redirect URL·allow list에 등록할 값: ${ZOOM_PUBLIC_BASE_URL}/auth/zoom/callback (docs/zoom.md 2절)
#   Event Subscriptions 수신 URL:                ${ZOOM_PUBLIC_BASE_URL}/zoom/webhook (docs/zoom.md 9절)
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_PUBLIC_BASE_URL=https://<your-subdomain>.ngrok-free.app
# Event Subscriptions의 Secret Token (URL 검증 응답과 x-zm-signature 검증에 쓴다. docs/zoom.md 9절)
ZOOM_WEBHOOK_SECRET_TOKEN=

# 토큰 저장 파일 경로 (테스트용 로컬 JSON)
TOKEN_STORE_PATH=.tokens/tokens.json
