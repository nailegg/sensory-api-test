# 로컬 서버
APP_BASE_URL=http://localhost:8000

# Google OAuth 2.0 (GCP 콘솔 > API 및 서비스 > 사용자 인증 정보 > OAuth 클라이언트 ID, 유형: 웹 애플리케이션)
# 승인된 리디렉션 URI: http://localhost:8000/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Zoom OAuth (Marketplace > General App, User-managed)
# 리다이렉트 URI: http://localhost:8000/auth/zoom/callback (https 요구 시 ngrok 주소. 1단계에서 확인)
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# 토큰 저장 파일 경로 (테스트용 로컬 JSON)
TOKEN_STORE_PATH=.tokens/tokens.json
